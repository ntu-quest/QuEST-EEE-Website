{
  "name": "quest-eee-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/images.mjs && node scripts/booth.mjs && node redesign/build-content.mjs && astro build && node scripts/ship-redesign.mjs",
    "build:old": "node scripts/images.mjs && node scripts/booth.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "prepare:content": "node scripts/images.mjs && node scripts/booth.mjs",
    "booth": "node scripts/booth.mjs",
    "images": "node scripts/images.mjs",
    "redesign:content": "node redesign/build-content.mjs",
    "redesign": "node redesign/build-content.mjs && python3 -m http.server 4400"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.6",
    "@astrojs/sitemap": "^3.3.1",
    "astro": "^5.7.13",
    "sharp": "^0.34.1",
    "@tailwindcss/vite": "^4.1.7",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "hast-util-to-html": "^9.0.5",
    "js-yaml": "^4.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "typescript": "^5.8.3"
  }
}
