---
/* 404 — the laboratory-notebook texture, and real routes out. */
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { media } from '../lib/content';

const notes = await media('entanglement-notes');
---
<Base title="Page not found" description="That page does not exist.">
  <section class="section">
    <div class="wrap lost">
      <div>
        <p class="eyebrow">404</p>
        <h1>That page isn't here.</h1>
        <p class="lede">
          Either it moved, or it never existed. Both are recoverable — unlike a measurement.
        </p>
        <ul class="ways">
          <li><a class="text-link" href="/">Home →</a></li>
          <li><a class="text-link" href="/demos">The demos →</a></li>
          <li><a class="text-link" href="/events">What's on →</a></li>
          <li><a class="text-link" href="/contact">Ask a person →</a></li>
        </ul>
      </div>
      {notes && <Figure entry={notes} caption sizes="(max-width: 820px) 100vw, 45vw" />}
    </div>
  </section>
</Base>
<style>
  .lost { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .ways { list-style: none; margin: 2rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  @media (max-width: 820px) { .lost { grid-template-columns: minmax(0, 1fr); } }
</style>
