---
/* /demos — the one page a first-time visitor can USE rather than read, which
   is why it is top-level in the nav and why a poster QR should point here.

   This header is the second and last place the interference field appears. */
import Base from '../../layouts/Base.astro';
import Field from '../../components/Field.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import { demos } from '../../lib/content';

const all = await demos();
---

<Base
  title="Demos"
  description="Four interactive quantum stations — Grover search, Bell/CHSH, Stern–Gerlach and VQE on H₂. They run in your browser, and they run offline."
>
  <section class="head">
    <Field />
    <div class="wrap inner">
      <p class="eyebrow">Demos</p>
      <h1>Four stations. Each one has a moment you cause yourself.</h1>
      <p class="lede">
        Not videos, not slides. Turn a knob and the physics answers. Every number on screen is
        checked against the original paper by a test suite before it is allowed to appear.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="stations">
        {all.map((demo) => (
          <a class="station" href={`/demos/${demo.id}`}>
            <p class="num mono">Station {demo.data.station} · {demo.data.concept}</p>
            <h2>{demo.data.title}</h2>
            <p class="hook">{demo.data.hook}</p>
            <p class="knobs mono">
              {demo.data.knobs.map((knob) => `${knob.label} (${knob.range})`).join(' · ')}
            </p>
            <p class="go"><span class="text-link">Open the station →</span></p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="offline">
    <div class="wrap">
      <div class="offline">
        <div>
          <h2>Take them with you</h2>
          <p>
            The whole bundle is plain HTML, CSS and JavaScript with no dependencies and no network
            access. Copy the folder onto a USB stick, open <code>index.html</code>, and all four
            stations run — which is exactly how they run at a showcase booth.
          </p>
          <p class="caption">
            The station pages on this site load their physics from that same bundle, unchanged —
            same numbers, same maths, different frame around it.
          </p>
          <p class="actions">
            <a class="btn btn-ice" href="/quest-demos-offline.zip" download>
              <Icon name="download" size={18} /> Download the bundle
            </a>
            <a class="text-link" href="/projects/qfest-booth">How it is built →</a>
          </p>
        </div>
        <aside class="verify">
          <p class="eyebrow">How the numbers are checked</p>
          <pre class="pipeline mono">papers
  ↓
verify/reference.py
  ↓
booth/physics.js
  ↓
the screen</pre>
          <p class="caption">
            Nothing appears on a station unless a test asserts it. The maths is typeset by a small
            TeX-subset renderer written for the project that emits native MathML — a CDN is no use
            to a booth machine with no wifi.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <CTABand
    title="Want to build the next one?"
    href="/projects/qfest-booth"
    action="Read the project"
    secondaryHref="/join"
    secondary="Or join the club"
  />
</Base>

<style>
  .head { position: relative; overflow: hidden; border-bottom: 1px solid var(--rule); }
  .inner { position: relative; z-index: 1; padding-block: clamp(3rem, 7vw, 5rem); }
  .head h1 { max-width: 18ch; }

  .stations { display: grid; gap: var(--gap); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .station {
    display: flex; flex-direction: column;
    padding: 1.75rem;
    background: var(--panel); border: 1px solid var(--rule); border-radius: var(--radius);
    text-decoration: none; color: inherit; box-shadow: var(--elevation);
  }
  .station:hover { border-color: var(--ice); color: inherit; }
  .station:hover h2 { color: var(--ice); }
  .num { font-size: var(--t-fine); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ice); margin-bottom: 0.6rem; }
  .station h2 { font-size: var(--t-sub); margin-bottom: 0.5rem; }
  .hook { color: var(--ink-soft); font-size: var(--t-small); margin-bottom: 1rem; }
  .knobs { font-size: var(--t-fine); color: var(--ink-faint); margin-bottom: 1.25rem; }
  .go { margin: auto 0 0; }

  .offline { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .offline p { color: var(--ink-soft); max-width: var(--measure); }
  .actions { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; margin-top: 1.5rem; }
  code { font-family: var(--mono); font-size: 0.92em; background: var(--panel-2); padding: 0.1em 0.35em; border-radius: 3px; }
  .verify { background: var(--panel); border: 1px solid var(--rule); border-radius: var(--radius); padding: 1.5rem; }
  .pipeline {
    font-size: var(--t-label); line-height: 1.6; color: var(--ink-soft);
    margin: 0 0 1rem; white-space: pre; overflow-x: auto;
  }

  @media (max-width: 820px) {
    .stations, .offline { grid-template-columns: minmax(0, 1fr); }
  }
</style>
