---
/* IconSet — single-weight line icons at 20px, stroke: currentColor, inline SVG.
   No icon font, no CDN, no emoji. An icon never carries meaning alone: every
   one of these appears beside a text label.

   The four platform marks (Instagram, LinkedIn, Telegram, GitHub) are each
   platform's own official glyph and are drawn as fills, not strokes — that is
   how their brand pages specify them. Everything else is a 1.5px stroke. */
interface Props {
  name:
    | 'telegram' | 'instagram' | 'linkedin' | 'github'
    | 'email' | 'form' | 'calendar' | 'demo'
    | 'arrow' | 'external' | 'menu' | 'close' | 'sun' | 'moon' | 'download' | 'check';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const brand = ['telegram', 'instagram', 'linkedin', 'github'].includes(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={brand ? 'currentColor' : 'none'}
  stroke={brand ? 'none' : 'currentColor'}
  stroke-width={brand ? undefined : 1.5}
  stroke-linecap={brand ? undefined : 'round'}
  stroke-linejoin={brand ? undefined : 'round'}
  aria-hidden="true"
  focusable="false"
>
