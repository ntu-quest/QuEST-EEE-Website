---
/* /about — who we are. The proof, not the adjectives. */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Figure from '../../components/Figure.astro';
import ProofStrip from '../../components/ProofStrip.astro';
import Timeline from '../../components/Timeline.astro';
import CTABand from '../../components/CTABand.astro';
import { media, sorted } from '../../lib/content';

const team = await media('team-garden');
const overhead = await media('team-overhead');
const milestones = await sorted('milestones');

const PROOF = [
  { figure: "Singapore's first", label: 'undergraduate, student-run quantum-centric club' },
  { figure: '180+ members', label: 'across NTU' },
  { figure: 'Running since 2025', label: 'workshops, projects, a cross-campus festival' },
];
---
<Base title="Who we are" description="QuEST@EEE — Quantum Engineering, Science & Technology at NTU EEE.">
  <PageHeader
    eyebrow="About"
    title="Quantum Engineering, Science &amp; Technology"
    lede="QuEST@EEE is the quantum interest club at NTU's School of Electrical & Electronic Engineering. We were the NTU Quantum Computing Club; the name changed because the remit did."
  />

  {team && (
    <div class="wrap"><Figure entry={team} caption eager sizes="(max-width: 1100px) 100vw, 1100px" /></div>
  )}

  <section class="section">
    <div class="wrap prose">
      <h2>Why the name changed</h2>
      <p>
        The club started as a quantum <em>computing</em> club, and computing is where most people
        first meet the subject. But the interesting work at NTU EEE is not only algorithms — it is
        photonics, control electronics, materials, and the measurement chain between a qubit and a
        number on a screen. Calling ourselves a computing club was quietly telling half our own
        school that this was not for them.
      </p>
      <p>
        <strong>Quantum Engineering, Science &amp; Technology</strong> is the wider remit, and the
        bra-ket in the mark is the same one that was there before. The old name and the old mark are
        on <a href="/about/journey">the journey page</a>, labelled as history rather than deleted.
      </p>

      <h2>What we are for</h2>
      <p>
        Lowering the barrier to entry, and then not stopping there. A club that only runs
        introductory workshops produces people who have heard of quantum computing. The test we hold
        ourselves to is different: a visitor should come away thinking <em>these people actually do
        things</em> — which is why the demos, the photographs and the dated events are on this site
        and the manifesto is one page down.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap"><ProofStrip items={PROOF} /></div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">The journey</p><h2>Four years, roughly</h2></div>
      <Timeline milestones={milestones} compact />
      <p class="after"><a class="text-link" href="/about/journey">The whole story →</a></p>
    </div>
  </section>

  {overhead && (
    <section class="section">
      <div class="wrap">
        <div class="split">
          <Figure entry={overhead} caption sizes="(max-width: 820px) 100vw, 45vw" />
          <div>
            <h2>The people</h2>
            <p class="lede">
              Nine committee members, two faculty advisors, and one open seat we would like you to
              take. Everyone here is an undergraduate doing this alongside a degree.
            </p>
            <p><a class="btn btn-ghost" href="/about/people">Meet them</a></p>
          </div>
        </div>
      </div>
    </section>
  )}

  <CTABand title="Explore. Build. Question. Become." href="/join" action="Join QuEST" secondaryHref="/about/culture" secondary="What we believe" />
</Base>
<style>
  .after { margin-top: 2rem; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  @media (max-width: 820px) { .split { grid-template-columns: minmax(0, 1fr); } }
</style>
