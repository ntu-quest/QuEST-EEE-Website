---
/* /explore/what-we-do — the answer to "what would I actually be doing here". */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Figure from '../../components/Figure.astro';
import CTABand from '../../components/CTABand.astro';
import { media } from '../../lib/content';

const workshop = await media('acads-unitary');
const session = await media('acads-laptops');
const philosophy = await media('quantum-x-philosophy-talk');
const notes = await media('entanglement-notes');

const BLOCKS = [
  {
    title: 'Workshops',
    photo: workshop,
    body: 'A rolling series that starts from nothing. Semester 1 is the groundwork — linear algebra, probability, states and gates. Semester 2 goes to algorithms and quantum machine learning. Sessions are taught by members, which is the point: the fastest way to find out whether you understand something is to be the one explaining it.',
    link: { href: '/events', label: 'The event archive' },
  },
  {
    title: 'Building',
    photo: session,
    body: 'Theory and the terminal in the same session. You write circuits, run them on a simulator, and see where the noise starts to matter. No prior exposure assumed — the tooling is taught alongside the physics rather than after it.',
    link: { href: '/demos', label: 'Try the demos' },
  },
  {
    title: 'Projects and research',
    photo: notes,
    body: 'Mentored work with a named deliverable at the end of it: problem, literature, implementation, evaluation, write-up. Teams check in weekly and report monthly. The point is not to produce a result nobody asked for — it is to learn to execute and communicate to a professional standard.',
    link: { href: '/projects', label: 'The projects' },
  },
  {
    title: 'Talks and the community',
    photo: philosophy,
    body: 'Guest lectures, panels, and the Quantum Questions series, run with other student groups across Singapore. Plus a Telegram group that is mostly people asking each other things — which is, honestly, where most of the learning happens.',
    link: { href: '/about/network', label: 'Who we work with' },
  },
];
---
<Base title="What we do" description="Workshops, building, mentored projects and talks — what being in QuEST@EEE actually involves.">
  <PageHeader
    eyebrow="Explore"
    title="What we actually do"
    lede="Four things, running at the same time. You are not required to do all of them, and most people start with one."
  />
  <section class="section-tight">
    <div class="wrap">
      {BLOCKS.map((block, index) => (
        <article class="block">
          <div class="shot">{block.photo && <Figure entry={block.photo} caption sizes="(max-width: 820px) 100vw, 40vw" />}</div>
          <div class="text">
            <p class="card-num">{String(index + 1).padStart(2, '0')}</p>
            <h2>{block.title}</h2>
            <p>{block.body}</p>
            <p><a class="text-link" href={block.link.href}>{block.link.label} →</a></p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CTABand title="That sound like your kind of thing?" href="/join" action="Join QuEST" secondaryHref="/explore/resources" secondary="Or just start reading" />
</Base>
<style>
  .block { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; padding-block: 2.5rem; border-top: 1px solid var(--rule); }
  .block:first-child { border-top: 0; padding-top: 0; }
  .block:nth-child(even) .shot { order: 2; }
  .text p { color: var(--ink-soft); max-width: 48ch; }
  @media (max-width: 820px) {
    .block { grid-template-columns: minmax(0, 1fr); }
    .block:nth-child(even) .shot { order: 0; }
  }
</style>
