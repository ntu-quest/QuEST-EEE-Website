---
/* /explore/resources — a router, not a reading list. Anchored tracks rather
   than modals: every track is linkable, and "I know nothing" is a real anchor
   you can send someone.

   Only what the club has published or already cites in its own repository is
   listed. The full five-track reading list is owned by Content Dev and the
   Reading Coordinators — until those exist, this page shows what is real and
   says so rather than padding itself out. */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Figure from '../../components/Figure.astro';
import MotionFigure from '../../components/MotionFigure.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { sorted, media } from '../../lib/content';

const resources = await sorted('resources');
const bloch = await media('bloch-sphere-slide');

const TRACKS = [
  { key: 'nothing', title: 'I know nothing about this', who: 'You have heard the word and that is all. Start here — it is where most of us started.' },
  { key: 'code', title: 'I can code', who: 'You are comfortable in Python and want to run something rather than read about it.' },
  { key: 'physics', title: 'I want the physics', who: 'You want to know what is actually happening, not just which gate to apply.' },
  { key: 'build', title: 'I want to build', who: 'You want to make something other people use — a demo, a station, a tool.' },
] as const;
---
<Base title="Resources" description="Where to start with quantum, depending on where you are starting from.">
  <PageHeader
    eyebrow="Explore"
    title="Where to start"
    lede="Four entry points. Pick the one that sounds like you, and work down the list in order — each item says how long it takes and why it is on the list at all."
  >
    <nav class="jump" aria-label="Tracks">
      {TRACKS.map((track) => <a href={`#${track.key}`} class="chip">{track.title}</a>)}
    </nav>
  </PageHeader>

  <section class="section-tight">
    <div class="wrap">
      {TRACKS.map((track) => {
        const items = resources.filter((r) => r.data.track === track.key && r.data.active);
        if (!items.length) return null;
        return (
          <section class="track" id={track.key}>
            <h2 class="rule">{track.title}</h2>
            <p class="who">{track.who}</p>
            <ol class="items">
              {items.map((item, index) => (
                <li>
                  <span class="n mono">{String(index + 1).padStart(2, '0')}</span>
                  <span class="detail">
                    <a href={item.data.url}>
                      {item.data.title}
                      {item.data.source === 'external' && <Icon name="external" size={15} />}
                    </a>
                    <span class="why">{item.data.why}</span>
                    <span class="meta mono">{item.data.type} · {item.data.estimatedTime} · {item.data.source === 'quest' ? 'ours' : 'external'}</span>
                  </span>
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </div>
  </section>

  <section class="section">
    <div class="wrap figures">
      <div class="fig">
        <Figure entry={bloch} caption sizes="(max-width: 760px) 100vw, 30vw" />
      </div>
      <div class="fig">
        <MotionFigure
          name="bloch_hadamard"
          alt="An animated Bloch sphere showing a Hadamard gate rotating the state vector from the pole to the equator."
          caption="A Hadamard, on the Bloch sphere. Generated by the club's own make_gifs.py."
        />
      </div>
      <div class="fig">
        <MotionFigure
          name="matrix_transform_3d"
          alt="An animated three-dimensional grid being deformed by a linear transformation."
          caption="What a matrix does to space — the groundwork the foundations track starts from."
        />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <p class="caption note">
        This list is deliberately short. Everything on it is either material the club made or a
        paper the club's own demos already cite, so every entry is one somebody here has actually
        read. The longer per-track reading lists are being written — if you want to help write one,
        that is a real job and it is open.
      </p>
    </div>
  </section>

  <CTABand title="Reading is the slow way in. The demos are the fast one." href="/demos" action="Try a demo" secondaryHref="/join" secondary="Or come to a workshop" />
</Base>
<style>
  .jump { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .chip {
    font-family: var(--display); font-weight: 600; font-size: var(--t-label);
    padding: 0.45rem 0.8rem; min-height: 40px; display: inline-flex; align-items: center;
    border: 1px solid var(--rule); border-radius: var(--radius);
    color: var(--ink-soft); text-decoration: none;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .track { margin-bottom: 3rem; scroll-margin-top: 6rem; }
  .rule { padding-bottom: 0.6rem; border-bottom: 2px solid var(--ink); margin-bottom: 0.75rem; }
  .who { color: var(--ink-soft); max-width: var(--measure); margin-bottom: 1.5rem; }
  .items { list-style: none; margin: 0; padding: 0; }
  .items li { display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .n { font-size: var(--t-fine); color: var(--ink-faint); flex: none; padding-top: 0.2rem; }
  .detail { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .detail a { font-family: var(--display); font-weight: 700; font-size: var(--t-small); text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; }
  .why { font-size: var(--t-small); color: var(--ink-soft); max-width: var(--measure); }
  .meta { font-size: var(--t-fine); color: var(--ink-faint); text-transform: capitalize; }
  .figures { display: grid; gap: var(--gap); grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
  .note { max-width: var(--measure); }
  @media (max-width: 820px) { .figures { grid-template-columns: minmax(0, 1fr); } }
</style>
